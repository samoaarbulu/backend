# Configuración General
PORT=3000
NODE_ENV=development
ENABLE_SWAGGER=true

# Base de Datos (PostgreSQL 16 + PostGIS en OVHcloud)
# Para desarrollo local (con tunel_db.bat activo):
DATABASE_URL="postgresql://creds_app_user_dev:<PASSWORD>@localhost:5432/creds_dev_db?schema=public&sslmode=prefer"
DIRECT_URL="postgresql://creds_user:<ADMIN_PASSWORD>@localhost:5432/creds_dev_db?schema=public&sslmode=prefer"

# Para producción (despliegue en Coolify / OVHcloud Virginia):
# DATABASE_URL="postgresql://creds_app_user_prod:<PROD_PASSWORD>@<SERVER_IP>:5432/creds_db?schema=public&sslmode=prefer"
# DIRECT_URL="postgresql://creds_user:<ADMIN_PASSWORD>@<SERVER_IP>:5432/creds_db?schema=public&sslmode=prefer"

# Firebase Auth (Verificación de Tokens en NestJS)
FIREBASE_PROJECT_ID=creds-app-prod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@creds-app-prod.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
